# Copy to .env and fill in. Everything the server needs lives here.

# --- Server ---
PORT=3000
# Any long random string; the app sends it as "Authorization: Bearer <token>".
# Leave empty to disable auth (not recommended on a public VPS).
API_TOKEN=change-me-to-a-long-random-string

# --- Twitter session (see README for how to export these two cookies) ---
TW_AUTH_TOKEN=
TW_CT0=
# Only set this if feed fetching starts failing (Twitter rotates it; see README).
#TW_HOME_QUERY_ID=
TWEET_COUNT=150

# --- LLM for clustering + summaries (anthropic | openai | deepseek) ---
LLM_PROVIDER=anthropic
# Leave empty for the provider default (anthropic: claude-sonnet-4-5,
# openai: gpt-4o-mini, deepseek: deepseek-chat)
LLM_MODEL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional: any OpenAI-compatible host serving DeepSeek models, e.g. NVIDIA's
# integrate.api.nvidia.com endpoint (key starts with nvapi-). Defaults to
# DeepSeek's own API.
#DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1

# --- TTS: "edge" (free Microsoft Edge voices, no key needed) or "openai" ---
TTS_PROVIDER=edge
# Pick any Edge voice, e.g. en-US-ChristopherNeural, en-US-AndrewNeural,
# en-US-AriaNeural, en-US-GuyNeural
EDGE_TTS_VOICE=en-US-ChristopherNeural

# --- OpenAI (TTS if TTS_PROVIDER=openai; LLM if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# --- Briefing shape / cost control ---
MAX_TOPICS=12
RETENTION_DAYS=7
